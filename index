  <div class="header-right">
    <div class="progress-badge">Progress: <strong id="progress-pct">0%</strong></div>
    <button class="btn btn-outline" style="padding:6px 14px;font-size:.8rem" onclick="showPage('predict')">🎯 Guess Paper</button>
  </div>
</header>

<nav class="sidebar" id="sidebar">
  <div class="sidebar-section">
    <div class="nav-item active" onclick="showPage('dashboard')"><span class="nav-icon">🏠</span>Dashboard</div>
    <div class="nav-item" onclick="showPage('formulas')"><span class="nav-icon">📐</span>Formula Sheet</div>
    <div class="nav-item" onclick="showPage('flashcards')"><span class="nav-icon">🃏</span>Flashcards</div>
    <div class="nav-item" onclick="showPage('mcq-hub')"><span class="nav-icon">✅</span>MCQ Practice</div>
    <div class="nav-item" onclick="showPage('heatmap')"><span class="nav-icon">🔥</span>Priority Heatmap</div>
    <div class="nav-item" onclick="showPage('predict')"><span class="nav-icon">🎯</span>Predicted Paper</div>
    <div class="nav-item" onclick="showPage('mindmap')"><span class="nav-icon">🗺</span>Mind Map</div>
    <div class="nav-item" onclick="showPage('revision')"><span class="nav-icon">⚡</span>Last Minute Revision</div>
  </div>
  <div class="sidebar-section">
    <div class="sidebar-label">Topics</div>
    <div class="nav-item" onclick="showPage('topic1')"><span class="nav-icon">🚀</span>1. Motion, Forces &amp; Energy<span class="topic-badge badge-hot">HOT</span></div>
    <div class="nav-item" onclick="showPage('topic2')"><span class="nav-icon">🌡</span>2. Thermal Physics<span class="topic-badge badge-key">KEY</span></div>
    <div class="nav-item" onclick="showPage('topic3')"><span class="nav-icon">🌊</span>3. Waves<span class="topic-badge badge-hot">HOT</span></div>
    <div class="nav-item" onclick="showPage('topic4')"><span class="nav-icon">⚡</span>4. Electricity &amp; Magnetism<span class="topic-badge badge-hot">HOT</span></div>
    <div class="nav-item" onclick="showPage('topic5')"><span class="nav-icon">☢</span>5. Nuclear Physics</div>
    <div class="nav-item" onclick="showPage('topic6')"><span class="nav-icon">🌌</span>6. Space Physics</div>
  </div>
  <div class="sidebar-section">
    <div class="nav-item" onclick="showPage('checklist')"><span class="nav-icon">📋</span>Syllabus Checklist</div>
  </div>
</nav>

<main class="main">
<!-- DASHBOARD -->
<div class="page active" id="page-dashboard">
  <div class="hero">
    <h1>IGCSE Physics <span>0625 Extended</span></h1>
    <p>Complete 2026–2028 syllabus preparation. Full notes, MCQ practice, predicted paper, flashcards and progress tracking — everything for Paper 2.</p>
    <div class="hero-stats">
      <div class="hero-stat"><span class="hero-stat-num">6</span><span class="hero-stat-label">Topics</span></div>
      <div class="hero-stat"><span class="hero-stat-num">40+</span><span class="hero-stat-label">Subtopics</span></div>
