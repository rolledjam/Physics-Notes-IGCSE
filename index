// ── MCQ ───────────────────────────────────────────────────────────────────────
function loadMCQs(topic){
  mcqFilter=topic;
  const data=topic==='all'?MCQ_DATA:MCQ_DATA.filter(m=>m.t===topic);
  document.getElementById('mcq-container').innerHTML=data.map((m,i)=>`
    <div class="mcq-card" id="mc${i}">
      <div class="mcq-header">
        <div class="q-num">${m.t.toUpperCase()} &middot; Q${i+1} <span class="mcq-difficulty diff-${m.d==='easy'?'easy':m.d==='med'?'med':'hard'}">${m.d}</span></div>
        <div class="q-text">${m.q}</div>
      </div>
      <div class="mcq-options">${m.o.map((o,j)=>`<div class="mcq-opt" onclick="answerMCQ(${i},${j},${m.a},'${btoa(m.e)}')" id="mo${i}_${j}"><div class="opt-letter">${'ABCD'[j]}</div>${o}</div>`).join('')}</div>
      <div class="mcq-explanation" id="me${i}"></div>
    </div>`).join('');
  updateScore();
}
function answerMCQ(qi,oi,correct,expb64){
  const card=document.getElementById('mc'+qi);
  if(card.dataset.done) return;
  card.dataset.done='1';
  const exp=atob(expb64);
  const ok=oi===correct;
  for(let j=0;j<4;j++){
    const o=document.getElementById('mo'+qi+'_'+j);
    if(!o) continue;
    if(j===correct) o.classList.add('correct');
    else if(j===oi&&!ok) o.classList.add('wrong');
  }
  const ed=document.getElementById('me'+qi);
  ed.innerHTML=`<strong style="color:${ok?'var(--green)':'var(--red)'}">${ok?'✅ Correct!':'❌ Incorrect — answer is '+'ABCD'[correct]}</strong><br><br>${exp}`;
  ed.classList.add('show');
  scores.t++;
  if(ok) scores.c++;
  localStorage.setItem('pa-sc',JSON.stringify(scores));
  updateScore();
}
function updateScore(){
  document.getElementById('sc-correct').textContent=scores.c;
  document.getElementById('sc-total').textContent=scores.t;
  const p=scores.t?Math.round(scores.c/scores.t*100):0;
  document.getElementById('sc-bar').style.width=p+'%';
}
function resetScore(){
  scores={c:0,t:0};
  localStorage.setItem('pa-sc',JSON.stringify(scores));
  updateScore();
  loadMCQs(mcqFilter);
}

