<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PhysicsAce — IGCSE Physics 0625 Extended 2026–2028</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0f;--bg2:#111118;--bg3:#18181f;--bg4:#22222c;--card:#1a1a24;--border:#2a2a38;--border2:#3a3a50;--text:#f0f0f8;--text2:#9898b8;--text3:#585878;--accent:#6366f1;--accent2:#818cf8;--accent3:#c7d2fe;--green:#34d399;--amber:#fbbf24;--red:#f87171;--blue:#60a5fa;--pink:#f472b6;--teal:#2dd4bf;--purple:#a78bfa;--sidebar-w:280px;--header-h:64px}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;scroll-behavior:smooth}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--text);min-height:100vh;overflow-x:hidden}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:var(--bg2)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
a{color:var(--accent2);text-decoration:none}
.header{position:fixed;top:0;left:0;right:0;height:var(--header-h);background:rgba(10,10,15,0.95);backdrop-filter:blur(12px);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 20px;gap:16px;z-index:100}
.logo{font-size:1.3rem;font-weight:700;color:var(--accent2);letter-spacing:-0.5px}
.logo span{color:var(--accent)}
.header-search{flex:1;max-width:400px;position:relative}
.header-search input{width:100%;padding:8px 16px 8px 40px;background:var(--bg3);border:1px solid var(--border);border-radius:24px;color:var(--text);font-size:.875rem;font-family:inherit;outline:none}
.header-search input:focus{border-color:var(--accent)}
.header-search::before{content:'🔍';position:absolute;left:14px;top:50%;transform:translateY(-50%);font-size:.75rem}
.header-right{margin-left:auto;display:flex;align-items:center;gap:12px}
.progress-badge{display:flex;align-items:center;gap:8px;padding:6px 14px;background:var(--bg3);border:1px solid var(--border);border-radius:20px;font-size:.8rem;color:var(--text2)}
.progress-badge strong{color:var(--green)}
.menu-toggle{display:none;background:none;border:none;color:var(--text);cursor:pointer;font-size:1.4rem;padding:4px}
.sidebar{position:fixed;left:0;top:var(--header-h);bottom:0;width:var(--sidebar-w);background:var(--bg2);border-right:1px solid var(--border);overflow-y:auto;transition:transform .3s ease;z-index:90}
.sidebar-section{padding:12px 0;border-bottom:1px solid var(--border)}
.sidebar-section:last-child{border-bottom:none}
.sidebar-label{padding:8px 20px;font-size:.7rem;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--text3);user-select:none}
.nav-item{display:flex;align-items:center;gap:10px;padding:9px 20px;cursor:pointer;font-size:.875rem;color:var(--text2);transition:all .15s;position:relative}
.nav-item:hover{background:var(--bg3);color:var(--text)}
.nav-item.active{background:rgba(99,102,241,.12);color:var(--accent2);font-weight:500}
.nav-item.active::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--accent);border-radius:0 2px 2px 0}
.nav-icon{font-size:1rem;width:20px;text-align:center;flex-shrink:0}
.topic-badge{margin-left:auto;font-size:.65rem;padding:2px 7px;border-radius:10px;font-weight:600}
.badge-hot{background:rgba(248,113,113,.2);color:var(--red)}
.badge-key{background:rgba(251,191,36,.2);color:var(--amber)}
.main{margin-left:var(--sidebar-w);padding-top:var(--header-h);min-height:100vh}
.page{display:none;padding:32px 36px;max-width:1100px}
.page.active{display:block}
.hero{background:linear-gradient(135deg,rgba(99,102,241,.15) 0%,rgba(167,139,250,.08) 100%);border:1px solid rgba(99,102,241,.2);border-radius:16px;padding:36px;margin-bottom:28px;position:relative;overflow:hidden}
.hero::after{content:'⚛';position:absolute;right:40px;top:50%;transform:translateY(-50%);font-size:80px;opacity:.06}
.hero h1{font-size:1.8rem;font-weight:700;margin-bottom:8px}
.hero h1 span{color:var(--accent2)}
.hero p{color:var(--text2);font-size:1rem;max-width:600px;line-height:1.6;margin-bottom:20px}
.hero-stats{display:flex;gap:20px;flex-wrap:wrap}
.hero-stat{display:flex;flex-direction:column}
.hero-stat-num{font-size:1.5rem;font-weight:700;color:var(--accent2)}
.hero-stat-label{font-size:.75rem;color:var(--text2)}
.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:24px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}
.grid-6{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:24px}
.topic-card{background:var(--card);border:1px solid var(--border);border-radius:14px;padding:22px;cursor:pointer;transition:all .2s;display:flex;flex-direction:column}
.topic-card:hover{border-color:var(--accent);box-shadow:0 0 0 1px rgba(99,102,241,.3)}
.topic-num{font-size:.7rem;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:8px;opacity:.6}
.topic-title{font-size:1rem;font-weight:600;margin-bottom:6px}
.topic-sub{font-size:.78rem;color:var(--text2);line-height:1.5;margin-bottom:14px;flex:1}
.progress-bar-wrap{background:var(--bg3);border-radius:4px;height:4px;margin-bottom:10px}
.progress-bar{height:4px;border-radius:4px;background:var(--accent);transition:width .4s}
.topic-footer{display:flex;justify-content:space-between;align-items:center}
.topic-count{font-size:.75rem;color:var(--text2)}
.section-title{font-size:1.25rem;font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:10px}
.section-title span{color:var(--accent2)}
.section-title small{font-size:.75rem;color:var(--text2);font-weight:400}
.notes-container{max-width:860px}
.subtopic-block{margin-bottom:28px}
.subtopic-header{display:flex;align-items:center;gap:10px;padding:12px 18px;margin-bottom:0;background:var(--bg3);border:1px solid var(--border);border-radius:10px 10px 0 0;cursor:pointer;font-weight:600;font-size:.95rem}
.subtopic-header:hover{background:var(--bg4)}
.subtopic-toggle{margin-left:auto;transition:transform .2s}
.subtopic-body{background:var(--card);border:1px solid var(--border);border-top:none;border-radius:0 0 10px 10px;padding:20px;display:block}
.subtopic-body.collapsed{display:none}
.def-box{background:rgba(99,102,241,.1);border-left:3px solid var(--accent);border-radius:0 8px 8px 0;padding:14px 16px;margin:12px 0;font-size:.9rem}
.def-box strong{color:var(--accent2);display:block;margin-bottom:4px;font-size:.75rem;letter-spacing:.5px;text-transform:uppercase}
.formula-box{background:var(--bg3);border:1px solid var(--border2);border-radius:8px;padding:14px 18px;margin:12px 0;font-family:'JetBrains Mono',monospace;font-size:.95rem;color:var(--amber);display:flex;align-items:center;gap:12px}
.formula-box .formula-label{font-size:.7rem;color:var(--text2);font-family:'Space Grotesk',sans-serif;min-width:100px}
.tip-box{background:rgba(52,211,153,.08);border-left:3px solid var(--green);border-radius:0 8px 8px 0;padding:12px 16px;margin:12px 0;font-size:.875rem}
.tip-box strong{color:var(--green)}
.warn-box{background:rgba(251,191,36,.08);border-left:3px solid var(--amber);border-radius:0 8px 8px 0;padding:12px 16px;margin:12px 0;font-size:.875rem}
.warn-box strong{color:var(--amber)}
.trap-box{background:rgba(248,113,113,.08);border-left:3px solid var(--red);border-radius:0 8px 8px 0;padding:12px 16px;margin:12px 0;font-size:.875rem}
.trap-box strong{color:var(--red)}
.supp-box{background:rgba(45,212,191,.08);border-left:3px solid var(--teal);border-radius:0 8px 8px 0;padding:12px 16px;margin:12px 0;font-size:.875rem}
.supp-box strong{color:var(--teal)}
.notes-text{font-size:.9rem;line-height:1.7;color:#d8d8e8}
.notes-text p{margin-bottom:10px}
.notes-text ul{padding-left:20px;margin-bottom:10px}
.notes-text li{margin-bottom:4px}
.notes-text h4{font-size:.85rem;font-weight:600;color:var(--accent3);margin:14px 0 6px;text-transform:uppercase;letter-spacing:.5px}
.checklist{list-style:none;padding:0}
.check-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid var(--border);font-size:.875rem;cursor:pointer}
.check-item:last-child{border-bottom:none}
.check-box{width:18px;height:18px;border:1.5px solid var(--border2);border-radius:4px;flex-shrink:0;margin-top:1px;transition:all .2s;display:flex;align-items:center;justify-content:center}
.check-item.done .check-box{background:var(--green);border-color:var(--green)}
.check-item.done .check-box::after{content:'✓';font-size:11px;color:#0a0a0f;font-weight:700}
.check-item.done .check-text{color:var(--text3);text-decoration:line-through}
.supp-tag{font-size:.65rem;padding:2px 6px;background:rgba(45,212,191,.15);color:var(--teal);border-radius:4px;font-weight:600;flex-shrink:0;margin-top:1px}
.mcq-card{background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:20px;overflow:hidden}
.mcq-header{padding:18px 20px;border-bottom:1px solid var(--border)}
.mcq-header .q-num{font-size:.7rem;color:var(--text2);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;display:flex;align-items:center;gap:8px}
.mcq-header .q-text{font-size:.95rem;line-height:1.5}
.mcq-options{padding:14px;display:flex;flex-direction:column;gap:8px}
.mcq-opt{padding:10px 16px;border-radius:8px;border:1px solid var(--border);cursor:pointer;font-size:.875rem;transition:all .15s;display:flex;align-items:center;gap:10px}
.mcq-opt:hover{border-color:var(--accent);background:rgba(99,102,241,.08)}
.mcq-opt.correct{border-color:var(--green);background:rgba(52,211,153,.12)}
.mcq-opt.wrong{border-color:var(--red);background:rgba(248,113,113,.1)}
.opt-letter{width:26px;height:26px;border-radius:50%;border:1.5px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:600;flex-shrink:0}
.mcq-opt.correct .opt-letter{background:var(--green);border-color:var(--green);color:#0a0a0f}
.mcq-opt.wrong .opt-letter{background:var(--red);border-color:var(--red);color:#fff}
.mcq-explanation{padding:16px 20px;background:var(--bg3);border-top:1px solid var(--border);font-size:.875rem;line-height:1.6;display:none}
.mcq-explanation.show{display:block}
.mcq-difficulty{font-size:.65rem;padding:3px 8px;border-radius:10px;font-weight:600}
.diff-easy{background:rgba(52,211,153,.15);color:var(--green)}
.diff-med{background:rgba(251,191,36,.15);color:var(--amber)}
.diff-hard{background:rgba(248,113,113,.15);color:var(--red)}
.fc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:14px}
.flashcard{height:160px;perspective:600px;cursor:pointer}
.fc-inner{width:100%;height:100%;position:relative;transition:transform .4s;transform-style:preserve-3d}
.flashcard.flipped .fc-inner{transform:rotateY(180deg)}
.fc-front,.fc-back{position:absolute;inset:0;backface-visibility:hidden;border-radius:10px;display:flex;flex-direction:column;padding:16px;border:1px solid var(--border)}
.fc-front{background:var(--card);justify-content:space-between}
.fc-back{background:linear-gradient(135deg,rgba(99,102,241,.15),rgba(167,139,250,.08));transform:rotateY(180deg);justify-content:center;border-color:rgba(99,102,241,.3)}
.fc-label{font-size:.65rem;color:var(--text2);text-transform:uppercase;letter-spacing:.8px;font-weight:600}
.fc-term{font-size:.9rem;font-weight:600;margin-top:8px}
.fc-back-text{font-size:.85rem;color:var(--accent3);text-align:center;line-height:1.5}
.formula-sheet-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.fs-card{background:var(--card);border:1px solid var(--border);border-radius:10px;padding:16px;transition:all .2s}
.fs-card:hover{border-color:var(--amber)}
.fs-name{font-size:.78rem;color:var(--text2);margin-bottom:6px;font-weight:500}
.fs-eq{font-family:'JetBrains Mono',monospace;font-size:1.1rem;color:var(--amber);font-weight:500;margin-bottom:6px}
.fs-vars{font-size:.75rem;color:var(--text3);line-height:1.5}
.heatmap{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-bottom:28px}
.hm-cell{border-radius:8px;padding:12px 10px;text-align:center;cursor:pointer;transition:transform .2s}
.hm-cell:hover{transform:scale(1.04)}
.hm-cell .hm-num{font-size:1.4rem;font-weight:700}
.hm-cell .hm-label{font-size:.7rem;margin-top:4px;font-weight:500}
.hm-hot{background:rgba(248,113,113,.18);border:1px solid rgba(248,113,113,.3);color:var(--red)}
.hm-warm{background:rgba(251,191,36,.14);border:1px solid rgba(251,191,36,.25);color:var(--amber)}
.hm-cool{background:rgba(96,165,250,.12);border:1px solid rgba(96,165,250,.2);color:var(--blue)}
.rank-table{width:100%;border-collapse:collapse;margin-bottom:24px}
.rank-table th{text-align:left;padding:10px 14px;font-size:.75rem;font-weight:600;color:var(--text2);letter-spacing:.5px;text-transform:uppercase;border-bottom:1px solid var(--border)}
.rank-table td{padding:11px 14px;font-size:.875rem;border-bottom:1px solid var(--border)}
.rank-table tr:hover td{background:var(--bg3)}
.rank-num{font-weight:700;color:var(--accent2);width:40px}
.bar-cell{display:flex;align-items:center;gap:10px}
.mini-bar{height:8px;border-radius:4px;background:var(--accent)}
.paper-header{background:var(--bg3);border:1px solid var(--border);border-radius:12px;padding:24px;margin-bottom:28px;text-align:center}
.paper-header h2{font-size:1.2rem;font-weight:700;margin-bottom:4px}
.paper-header p{font-size:.85rem;color:var(--text2)}
.paper-q{background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:16px;overflow:hidden}
.paper-q-head{padding:16px 20px;display:flex;align-items:flex-start;gap:12px;border-bottom:1px solid var(--border)}
.paper-q-num{font-size:.9rem;font-weight:700;color:var(--accent2);min-width:32px;padding-top:2px}
.paper-q-text{font-size:.9rem;flex:1;line-height:1.5}
.paper-q-opts{padding:12px 20px;display:flex;flex-direction:column;gap:6px}
.paper-q-opt{padding:8px 14px;border-radius:6px;border:1px solid var(--border);font-size:.85rem;display:flex;gap:10px;cursor:pointer;transition:all .15s}
.paper-q-opt:hover{border-color:var(--accent);background:rgba(99,102,241,.08)}
.paper-q-opt.correct-ans{border-color:var(--green);background:rgba(52,211,153,.1)}
.paper-q-opt.wrong-ans{border-color:var(--red);background:rgba(248,113,113,.08)}
.paper-q-sol{padding:14px 20px;background:rgba(99,102,241,.06);border-top:1px solid var(--border);font-size:.85rem;line-height:1.6;display:none}
.paper-q-sol.show{display:block}
.btn-sol{background:none;border:1px solid var(--border);color:var(--text2);padding:6px 14px;border-radius:6px;font-size:.78rem;cursor:pointer;font-family:inherit;margin-top:4px;transition:all .15s}
.btn-sol:hover{border-color:var(--accent2);color:var(--accent2)}
.btn{display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:var(--accent);color:#fff;border:none;border-radius:8px;font-family:inherit;font-size:.875rem;font-weight:600;cursor:pointer;transition:all .15s}
.btn:hover{background:var(--accent2)}
.btn-outline{background:none;border:1px solid var(--border2);color:var(--text)}
.btn-outline:hover{border-color:var(--accent2);background:rgba(99,102,241,.08)}
#search-results{display:none;position:absolute;top:calc(100% + 8px);left:0;right:0;background:var(--bg2);border:1px solid var(--border);border-radius:10px;max-height:320px;overflow-y:auto;z-index:200;box-shadow:0 8px 24px rgba(0,0,0,.4)}
.search-result{padding:10px 16px;cursor:pointer;border-bottom:1px solid var(--border);font-size:.875rem}
.search-result:hover{background:var(--bg3)}
.search-result:last-child{border-bottom:none}
.sr-tag{font-size:.65rem;color:var(--accent2);font-weight:600;margin-bottom:2px;display:block}
.tag-row{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 20px}
.tag{font-size:.7rem;padding:3px 10px;border-radius:12px;font-weight:500}
.tag-blue{background:rgba(96,165,250,.15);color:var(--blue)}
.tag-green{background:rgba(52,211,153,.15);color:var(--green)}
.tag-amber{background:rgba(251,191,36,.15);color:var(--amber)}
.tag-purple{background:rgba(167,139,250,.15);color:var(--purple)}
.tag-pink{background:rgba(244,114,182,.15);color:var(--pink)}
.tag-teal{background:rgba(45,212,191,.15);color:var(--teal)}
.mindmap-container{width:100%;height:580px;background:var(--bg3);border:1px solid var(--border);border-radius:12px;overflow:hidden}
.mindmap-svg{width:100%;height:100%}
.rad-table{width:100%;border-collapse:collapse;font-size:.82rem;margin:12px 0}
.rad-table th{padding:8px 12px;text-align:left;border-bottom:1px solid var(--border);color:var(--text2);font-weight:600}
.rad-table td{padding:9px 12px;border-bottom:1px solid var(--border)}
.rad-table tr:hover td{background:var(--bg3)}
@media(max-width:768px){.sidebar{transform:translateX(-100%)}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.page{padding:20px 16px}.grid-2,.grid-3,.grid-6{grid-template-columns:1fr}.heatmap{grid-template-columns:repeat(3,1fr)}.menu-toggle{display:block}}
</style>
</head>
<body>
<header class="header">
  <button class="menu-toggle" onclick="toggleSidebar()">☰</button>
  <div class="logo">Physics<span>Ace</span></div>
  <div class="header-search">
    <input type="text" id="search-input" placeholder="Search formulas, concepts, definitions..." oninput="doSearch(this.value)" onfocus="showSR()" onblur="setTimeout(hideSR,200)">
    <div id="search-results"></div>
