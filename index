const MCQ_DATA = [
  // Topic 1
  {t:'t1',q:'A car travels 120 m in 8 s at constant speed. What is its speed?',o:['10 m/s','15 m/s','16 m/s','20 m/s'],a:1,d:'easy',e:'v = s/t = 120/8 = 15 m/s. Simple substitution. Incorrect options: 10 = 120/12, 16 is wrong arithmetic, 20 = 120/6.'},
  {t:'t1',q:'Which quantity is a VECTOR?',o:['Speed','Mass','Temperature','Acceleration'],a:3,d:'easy',e:'Acceleration has magnitude AND direction, making it a vector. Speed, mass and temperature are scalars (magnitude only). Velocity is also a vector but is not in this list.'},
  {t:'t1',q:'A ball is dropped from rest. Taking g = 10 m/s², how far does it fall in 3 s?',o:['15 m','30 m','45 m','90 m'],a:2,d:'med',e:'s = ½gt² = ½ × 10 × 9 = 45 m. Use s = ½at² because initial velocity = 0. Common error: using s = gt² (forgetting the ½).'},
  {t:'t1',q:'The area under a speed–time graph represents:',o:['Acceleration','Force','Distance travelled','Velocity change'],a:2,d:'easy',e:'Area under a speed-time graph = distance travelled. The gradient of a speed-time graph = acceleration. Don\'t confuse gradient and area.'},
  {t:'t1',q:'A 4 kg object accelerates at 5 m/s². What is the resultant force?',o:['0.8 N','9 N','20 N','80 N'],a:2,d:'easy',e:'F = ma = 4 × 5 = 20 N. Newton\'s Second Law. Make sure to use resultant (net) force, not just any force.'},
  {t:'t1',q:'A 3 kg object moves at 4 m/s. What is its kinetic energy?',o:['6 J','12 J','24 J','48 J'],a:2,d:'med',e:'Eₖ = ½mv² = ½ × 3 × 16 = 24 J. Note: v² = 4² = 16. The ½ is essential — a very common error is to write Eₖ = mv².'},
  {t:'t1',q:'A 5 N force acts 0.4 m from a pivot. What is the moment?',o:['0.08 Nm','2 Nm','5.4 Nm','12.5 Nm'],a:1,d:'easy',e:'Moment = F × d = 5 × 0.4 = 2 Nm. Make sure to use perpendicular distance from the pivot.'},
  {t:'t1',q:'An object moving with constant velocity has:',o:['Zero acceleration and zero resultant force','Zero acceleration but non-zero resultant force','Non-zero acceleration and non-zero resultant force','Non-zero acceleration but zero resultant force'],a:0,d:'med',e:'Constant velocity means no change in speed or direction → zero acceleration. By Newton\'s 1st Law, zero resultant force. This is equilibrium.'},
  {t:'t1',q:'A 2 kg object is lifted 5 m. What gain in gravitational PE? (g = 10 N/kg)',o:['1 J','10 J','100 J','25 J'],a:2,d:'easy',e:'ΔEₚ = mgΔh = 2 × 10 × 5 = 100 J.'},
  {t:'t1',q:'A machine does 600 J of work in 30 s. What is its power?',o:['2 W','20 W','18000 W','200 W'],a:1,d:'easy',e:'P = W/t = 600/30 = 20 W.'},
  // Topic 2
  {t:'t2',q:'Which correctly explains why melting occurs at constant temperature?',o:['Energy is released by particles','Energy breaks bonds between particles without changing KE','Particles speed up during melting','Temperature is too low to change'],a:1,d:'med',e:'During melting, energy input breaks bonds (overcomes intermolecular forces) without changing particle kinetic energy, so temperature stays constant. The energy goes into potential energy, not KE.'},
  {t:'t2',q:'Convert 127°C to Kelvin:',o:['127 K','254 K','400 K','146 K'],a:2,d:'easy',e:'T(K) = θ(°C) + 273 = 127 + 273 = 400 K. Always add 273.'},
  {t:'t2',q:'A gas at 200 kPa occupies 3 m³. If compressed to 1 m³ at constant temperature, what is the new pressure?',o:['67 kPa','200 kPa','400 kPa','600 kPa'],a:3,d:'med',e:'Boyle\'s Law: p₁V₁ = p₂V₂ → 200×3 = p₂×1 → p₂ = 600 kPa. Pressure triples when volume is reduced to one-third.'},
  {t:'t2',q:'Which surface is the BEST absorber of infrared radiation?',o:['White, shiny','White, dull','Black, shiny','Black, dull'],a:3,d:'med',e:'Black, dull (matt) surfaces are the best absorbers AND best emitters. Shiny, light surfaces are best reflectors. This explains why solar panels are black and shiny reflectors are used to keep things cool.'},
  {t:'t2',q:'Evaporation causes cooling because:',o:['Cold air replaces evaporated molecules','The most energetic molecules escape, lowering the average KE','Water absorbs heat from surroundings','Evaporation releases thermal energy'],a:1,d:'med',e:'The most energetic molecules escape during evaporation. The remaining liquid has lower average kinetic energy → lower temperature. This is why sweating cools the body.'},
  {t:'t2',q:'Which is the main method of thermal energy transfer in a metal rod?',o:['Convection','Radiation','Conduction by lattice vibrations only','Conduction by free electrons and lattice vibrations'],a:3,d:'med',e:'In metals, conduction occurs via two mechanisms: free (delocalised) electron movement AND lattice vibrations. The free electrons make metals much better conductors than non-metals.'},
  // Topic 3
  {t:'t3',q:'A wave has frequency 250 Hz and wavelength 1.2 m. What is its speed?',o:['208 m/s','250 m/s','300 m/s','1500 m/s'],a:2,d:'easy',e:'v = fλ = 250 × 1.2 = 300 m/s. This is actually the speed of sound in some conditions!'},
  {t:'t3',q:'Which type of wave cannot travel through a vacuum?',o:['Gamma rays','Radio waves','Sound waves','X-rays'],a:2,d:'easy',e:'Sound is a mechanical (longitudinal) wave that requires a medium. All EM waves (radio, gamma, X-rays, visible light etc.) can travel through vacuum.'},
  {t:'t3',q:'What happens to light entering a denser medium?',o:['Speeds up; bends away from normal','Slows down; bends towards normal','Slows down; bends away from normal','Speeds up; bends towards normal'],a:1,d:'med',e:'Denser medium → light slows down → bends towards the normal (Snell\'s Law). Mnemonic: "Slow toward, fast away" from the normal.'},
  {t:'t3',q:'Which region of the EM spectrum is used to sterilise medical equipment?',o:['Infrared','Ultraviolet','Microwaves','Gamma rays'],a:3,d:'med',e:'Gamma rays are used to sterilise medical equipment because they are highly penetrating and can kill bacteria/microorganisms without heating. UV is also used for sterilising water.'},
  {t:'t3',q:'A glass block has refractive index 1.5. What is the critical angle?',o:['33.6°','41.8°','48.2°','56.4°'],a:1,d:'hard',e:'n = 1/sin c → sin c = 1/n = 1/1.5 = 0.667 → c = sin⁻¹(0.667) ≈ 41.8°. Above this angle, TIR occurs.'},
  {t:'t3',q:'Diffraction is greatest when:',o:['The gap is much larger than the wavelength','The wavelength equals the gap size','The gap is much smaller than the wavelength','The frequency is very high'],a:1,d:'med',e:'Diffraction is maximum when wavelength ≈ gap size. If gap >> λ, very little diffraction. If gap << λ, waves are blocked or barely pass through.'},
  // Topic 4
  {t:'t4',q:'Three 6Ω resistors are connected in series. What is the total resistance?',o:['2Ω','6Ω','12Ω','18Ω'],a:3,d:'easy',e:'Series: R = R₁+R₂+R₃ = 6+6+6 = 18Ω. In series, resistances simply add.'},
  {t:'t4',q:'Two 12Ω resistors are connected in parallel. What is their combined resistance?',o:['6Ω','12Ω','24Ω','144Ω'],a:0,d:'med',e:'1/R = 1/12 + 1/12 = 2/12 → R = 6Ω. Result is LESS than either individual resistor. For two equal resistors in parallel: R = R/2.'},
  {t:'t4',q:'A step-up transformer has 100 primary turns and 500 secondary turns. If input is 50V, what is output?',o:['10V','50V','250V','2500V'],a:2,d:'med',e:'Vp/Vs = Np/Ns → 50/Vs = 100/500 = 0.2 → Vs = 250V. Ratio = 500/100 = 5. Step-up: output voltage is 5× input.'},
  {t:'t4',q:'Why is electricity transmitted at high voltage?',o:['To increase power output','To reduce current and minimise I²R losses in cables','To increase the current flowing','To make transformers more efficient'],a:1,d:'med',e:'P_loss = I²R. High voltage → lower current (P=IV, fixed) → much lower cable losses. Doubling voltage and halving current reduces cable losses by factor of 4.'},
  {t:'t4',q:'A 240V appliance draws 2A. What is its power?',o:['120W','240W','480W','2880W'],a:2,d:'easy',e:'P = IV = 2 × 240 = 480W.'},
  {t:'t4',q:'What happens in a circuit when a fuse blows?',o:['Current increases','Current decreases temporarily','Circuit is broken and current stops','Voltage increases'],a:2,d:'easy',e:'A fuse melts when current exceeds its rating → wire breaks → circuit is open → no current flows. This protects the wiring from overheating.'},
  // Topic 5
  {t:'t5',q:'An α particle is emitted from ²²⁶₈₈Ra. What is the daughter nucleus?',o:['²²⁴₈₆Rn','²²²₈₆Rn','²²²₈₈Ra','²²⁶₈₆Rn'],a:1,d:'hard',e:'α-decay: A–4, Z–2. So A: 226–4=222, Z: 88–2=86. Element 86 = Radon (Rn). Correct: ²²²₈₆Rn.'},
  {t:'t5',q:'Which radiation has the greatest penetrating power?',o:['Alpha','Beta','Gamma','They are all the same'],a:2,d:'easy',e:'Gamma is most penetrating (requires cm of lead or metres of concrete). Alpha is stopped by paper or a few cm of air. Beta by a few mm of aluminium.'},
  {t:'t5',q:'A sample has initial count rate 480 counts/min. After 12 minutes it is 60 counts/min. What is the half-life?',o:['3 min','4 min','6 min','12 min'],a:1,d:'med',e:'480 → 240 → 120 → 60. Three halvings in 12 minutes. So half-life = 12/3 = 4 minutes.'},
  {t:'t5',q:'Which isotope is most suitable for a smoke detector?',o:['Short half-life, β emitter','Long half-life, α emitter','Short half-life, γ emitter','Long half-life, γ emitter'],a:1,d:'hard',e:'Smoke detectors need: α (ionises air in detector chamber) and long half-life (doesn\'t need frequent replacement). Am-241 is used: α emitter, half-life ~432 years.'},
  {t:'t5',q:'What is background radiation?',o:['Radiation from nuclear power stations only','Natural and artificial radiation always present in the environment','Radiation from medical sources only','Radiation detected only in certain locations'],a:1,d:'easy',e:'Background radiation is always present from natural sources (radon gas, rocks, food, cosmic rays) plus some artificial sources. It must be measured and subtracted in nuclear experiments.'},
  // Topic 6
  {t:'t6',q:'What provides the centripetal force for planets orbiting the Sun?',o:['Magnetic force','The vacuum of space','Gravitational attraction of the Sun','Centrifugal force'],a:2,d:'easy',e:'Gravitational attraction of the Sun acts as the centripetal force, pulling planets towards the Sun and keeping them in orbit.'},
  {t:'t6',q:'Redshift of light from distant galaxies is evidence that:',o:['Galaxies are cooling down','The Universe is contracting','The Universe is expanding','Stars are moving closer to Earth'],a:2,d:'easy',e:'Redshift (longer wavelength than emitted) indicates galaxies are moving away from us. The further the galaxy, the greater the redshift (Hubble\'s Law). This supports the Big Bang theory of an expanding Universe.'},
  {t:'t6',q:'What is the fate of a massive star after it becomes a red supergiant?',o:['It becomes a white dwarf','It collapses into a planetary nebula','It explodes as a supernova leaving a neutron star or black hole','It cools to become a black dwarf'],a:2,d:'med',e:'Massive stars: Red supergiant → supernova explosion → neutron star (less massive) or black hole (very massive). Average stars: Red giant → planetary nebula → white dwarf.'},
  {t:'t6',q:'What is the Cosmic Microwave Background Radiation (CMBR)?',o:['Radiation from mobile phone towers','Microwave radiation uniformly distributed in all directions in space','Radiation from stars in the Milky Way','Background noise in radio telescopes'],a:1,d:'hard',e:'CMBR is microwave radiation detected uniformly from all directions. It is the redshifted remnant of high-energy radiation from shortly after the Big Bang. As the Universe expanded, the radiation\'s wavelength increased into the microwave range.'},
];

