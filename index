// ── CHECKLIST ─────────────────────────────────────────────────────────────────
function renderChecklist(){
  let total=0;
  document.getElementById('checklist-container').innerHTML=CL_DATA.map((sec,si)=>{
    total+=sec.items.length;
    return `<div style="margin-bottom:24px">
      <div style="font-weight:600;font-size:1rem;padding:12px 0;border-bottom:1px solid var(--border);margin-bottom:8px">${sec.topic}</div>
      <ul class="checklist">${sec.items.map((item,ii)=>{
        const key=`${si}-${ii}`;
        const done=checks[key];
        return `<li class="check-item ${done?'done':''}" onclick="toggleCheck('${key}',this)">
          <div class="check-box"></div><span class="check-text">${item.t}</span>
          ${item.s?'<span class="supp-tag">Supp</span>':''}
        </li>`;
      }).join('')}</ul></div>`;
  }).join('');
  document.getElementById('chk-tot').textContent=total;
  updateCheckProgress();
}
function toggleCheck(key,el){
  checks[key]=!checks[key];
  el.classList.toggle('done');
  localStorage.setItem('pa-ck',JSON.stringify(checks));
  updateCheckProgress();
}
function updateCheckProgress(){
  const total=CL_DATA.reduce((a,s)=>a+s.items.length,0);
  const done=Object.values(checks).filter(Boolean).length;
  const p=Math.round(done/total*100);
  document.getElementById('chk-bar').style.width=p+'%';
  document.getElementById('chk-pct').textContent=p+'%';
  document.getElementById('chk-done').textContent=done;
  document.getElementById('chk-tot').textContent=total;
  document.getElementById('progress-pct').textContent=p+'%';
}

