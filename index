  const svg=document.getElementById('mm-svg');
  const nodes=[
    {id:'topic1',label:'Motion, Forces\n& Energy',x:200,y:180,color:'#6366f1',sub:['Kinematics','Newton\'s Laws','Momentum','Energy','Pressure']},
    {id:'topic2',label:'Thermal\nPhysics',x:200,y:400,color:'#f87171',sub:['Kinetic Model','Gas Laws','SHC','Heat Transfer']},
    {id:'topic3',label:'Waves',x:500,y:110,color:'#34d399',sub:['Wave Props','Light/Optics','EM Spectrum','Sound']},
    {id:'topic4',label:'Electricity &\nMagnetism',x:800,y:180,color:'#fbbf24',sub:['Circuits','Components','EM Induction','Transformers']},
    {id:'topic5',label:'Nuclear\nPhysics',x:800,y:400,color:'#a78bfa',sub:['Atomic Model','Radioactivity','Half-life','Safety']},
    {id:'topic6',label:'Space\nPhysics',x:500,y:470,color:'#2dd4bf',sub:['Solar System','Stars','Universe','Big Bang']},
  ];
  const cx=500,cy=290;
  let h='';
  // Centre node
  h+=`<circle cx="${cx}" cy="${cy}" r="60" fill="#111118" stroke="#6366f1" stroke-width="2.5"/>
    <text x="${cx}" y="${cy-8}" text-anchor="middle" font-size="14" fill="#818cf8" font-family="Space Grotesk" font-weight="700">IGCSE</text>
    <text x="${cx}" y="${cy+10}" text-anchor="middle" font-size="12" fill="#9898b8" font-family="Space Grotesk">Physics 0625</text>`;
  // Lines from centre to topics
  nodes.forEach(n=>{
    h+=`<line x1="${cx}" y1="${cy}" x2="${n.x}" y2="${n.y}" stroke="${n.color}" stroke-width="1.5" opacity="0.4" stroke-dasharray="6,3"/>`;
  });
  // Sub nodes
  nodes.forEach(n=>{
    n.sub.forEach((s,si)=>{
      const angle=(si/n.sub.length)*2*Math.PI - Math.PI/2;
      const r=90,sx=n.x+Math.cos(angle)*r,sy=n.y+Math.sin(angle)*r*0.65;
      if(sx>5&&sx<995&&sy>5&&sy<575){
        h+=`<line x1="${n.x}" y1="${n.y}" x2="${sx}" y2="${sy}" stroke="${n.color}" stroke-width="1" opacity="0.25"/>`;
        h+=`<g onclick="showPage('${n.id}')" style="cursor:pointer">
          <rect x="${sx-40}" y="${sy-11}" width="80" height="22" rx="11" fill="${n.color}22" stroke="${n.color}" stroke-width="1" opacity="0.7"/>
          <text x="${sx}" y="${sy+4}" text-anchor="middle" font-size="9.5" fill="${n.color}" font-family="Space Grotesk">${s}</text></g>`;
      }
    });
  });
  // Topic nodes
  nodes.forEach(n=>{
    const lines=n.label.split('\n');
    h+=`<g onclick="showPage('${n.id}')" style="cursor:pointer">
      <circle cx="${n.x}" cy="${n.y}" r="50" fill="#111118" stroke="${n.color}" stroke-width="2.5"/>
      ${lines.map((l,i)=>`<text x="${n.x}" y="${n.y+(i-lines.length/2+0.5)*16}" text-anchor="middle" font-size="11.5" fill="${n.color}" font-family="Space Grotesk" font-weight="600">${l}</text>`).join('')}
    </g>`;
  });
  svg.innerHTML=h;
}

